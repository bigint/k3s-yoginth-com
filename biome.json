{
  "files": {
    "includes": [
      "app/**/*.{css,ts,tsx}",
      "lib/**/*.ts",
      "next.config.ts",
      "*.{json,mjs}"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "none"
    }
  }
}
